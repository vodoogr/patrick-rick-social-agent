# Set only in Vercel Environment Variables; do not commit secrets.
# Use the PostgreSQL connection string copied from the selected Neon project.
DATABASE_URL=
# Random secret >= 32 characters, configured server-side only.
AGENT_MCP_TOKEN=
BETTER_AUTH_SECRET=
PATRICK_OWNER_EMAIL=
# Separate one-time installation secret; remove after creating the owner.
PATRICK_SETUP_TOKEN=
# Stable Preview origin, without path; defaults to VERCEL_BRANCH_URL on Vercel.
PATRICK_APP_ORIGIN=
# Keep static until the OAuth acceptance checklist passes. No simultaneous fallback.
PATRICK_MCP_AUTH_MODE=static
