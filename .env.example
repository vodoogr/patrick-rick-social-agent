# Vercel server-side variables. Never commit values or copy them into chat.
# DATABASE_URL is for local development and Production only.
# Preview requires its own URL and an exact Neon endpoint hostname.
PATRICK_PREVIEW_DATABASE_URL=
PATRICK_DATABASE_HOST=
# Set capabilities explicitly for each deployment.
PATRICK_SOCIAL_DRAFT_WRITES_ENABLED=false
PATRICK_VIDEO_DRAFTS_ENABLED=false
PATRICK_CATALOG_REVIEW_ENABLED=false
DATABASE_URL=
# Legacy static-token MCP mode only. At least 32 random characters.
AGENT_MCP_TOKEN=
# Better Auth signing secret, generated and stored separately per environment.
BETTER_AUTH_SECRET=
PATRICK_OWNER_EMAIL=
# Exact HTTPS origin (no path / trailing slash); production must be stable.
PATRICK_APP_ORIGIN=
# Hosted deployments require OAuth. Static mode is for local tests only.
PATRICK_MCP_AUTH_MODE=oauth

# The retired PATRICK_SETUP_TOKEN MUST NOT be configured.
# For the local-only owner migration see docs/owner-migration-runbook.md.
# Never add PATRICK_SOURCE_DATABASE_URL or PATRICK_TARGET_DATABASE_URL to Vercel.
