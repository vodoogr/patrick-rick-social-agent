# Vercel server-side variables. Never commit values or copy them into chat.
# DATABASE_URL must point to the proper Neon branch/database per environment.
DATABASE_URL=
# Legacy static-token MCP mode only. At least 32 random characters.
AGENT_MCP_TOKEN=
# Better Auth signing secret, generated and stored separately per environment.
BETTER_AUTH_SECRET=
PATRICK_OWNER_EMAIL=
# Exact HTTPS origin (no path / trailing slash); production must be stable.
PATRICK_APP_ORIGIN=
# Keep static until real OAuth browser/MCP acceptance has passed.
PATRICK_MCP_AUTH_MODE=static

# The retired PATRICK_SETUP_TOKEN MUST NOT be configured.
# For the local-only owner migration see docs/owner-migration-runbook.md.
# Never add PATRICK_SOURCE_DATABASE_URL or PATRICK_TARGET_DATABASE_URL to Vercel.
